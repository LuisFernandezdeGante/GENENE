@model IEnumerable<CamionesWebMVC_v01.Models.Ruta>

@{
    ViewBag.Title = "RUTAS";
}

<style>
    body {
        background-color: #472036c5;
    }



    section.col-md-4 {
        background-color: ghostwhite;
    }

    .btn-agregar {
        background-color: limegreen;
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: bold;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-agregar:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
        }

        .btn-agregar:active {
            transform: scale(0.98);
        }


    .btn-agregar2 {
        background-color: violet;
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: bold;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-agregar2:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
        }

        .btn-agregar2:active {
            transform: scale(0.98);
        }
</style>

<h2>RUTAS</h2>

<p class="btn btn-agregar">
    @Html.ActionLink("Crear Nuevo", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Origen)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Destino)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FechaSalida)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FechaLlegada)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ATiempo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Distancia)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FechaRegistro)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Camione.Matricula)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Chofere.Nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Origen)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Destino)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FechaSalida)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FechaLlegada)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ATiempo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Distancia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FechaRegistro)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Camione.Matricula)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Chofere.Nombre)
        </td>
        <td class="btn btn-agregar">
            @Html.ActionLink("EDITAR", "Edit", new { id=item.IdRutas }) |
            @Html.ActionLink("DETALLES", "Details", new { id=item.IdRutas }) |
            @Html.ActionLink("BORRAR", "Delete", new { id=item.IdRutas })
        </td>
    </tr>
}

</table>
