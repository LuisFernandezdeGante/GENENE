@model CamionesWebMVC_v01.Models.Chofere

@{
    ViewBag.Title = "Edit";
}

<style>
    body {
        background-color: #472036c5;
    }



    section.col-md-4 {
        background-color: ghostwhite;
    }

    .btn-agregar {
        background-color: limegreen;
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: bold;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-agregar:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
        }

        .btn-agregar:active {
            transform: scale(0.98);
        }


    .btn-agregar2 {
        background-color: violet;
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: bold;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-agregar2:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
        }

        .btn-agregar2:active {
            transform: scale(0.98);
        }
</style>


<h2>EDITAR</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>CHOFERES</h4>
