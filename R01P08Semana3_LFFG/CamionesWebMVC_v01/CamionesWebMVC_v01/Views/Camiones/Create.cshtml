@model CamionesWebMVC_v01.Models.Camione

@{
    ViewBag.Title = "Create";
}

<style>
    body {
        background-color: #472036c5;
    }

    /*main {
        background-color: #f3d759;
    }*/

    section.col-md-4 {
        background-color: ghostwhite;
    }

    .btn-agregar {
        background-color: limegreen;
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: bold;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-agregar:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
        }

        .btn-agregar:active {
            transform: scale(0.98);
        }


    .btn-agregar2 {
        background-color: violet;
        color: white;
        border: none;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: bold;
        border-radius: 30px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-agregar2:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.3);
        }

        .btn-agregar2:active {
            transform: scale(0.98);
        }
</style>

<h2>AGREGAR</h2>

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>CAMIONES</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Matricula, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Matricula, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Matricula, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.TipoCamion, htmlAttributes: new { @class = "control-label col-md-2" })
